---
const timeline = [
  {
    period: '2026',
    title: 'AI Agent Framework',
    role: 'MY Company · OpenCode + MCP',
    desc: 'Built an AI-agent operating system — CEO, sales, and SEO agents working 24/7 across strategy, outreach, and technical audits.',
    stack: ['Gemini', 'OpenCode', 'MCP', 'Agents'],
  },
  {
    period: '2025-Present',
    title: 'Automation & AI Systems Engineer',
    role: 'Rex Bunny Services · Self-built',
    desc: 'Designed and shipped the lead generation & outreach pipeline (n8n, PocketBase, Ollama, Maileroo) — 3,500+ leads, 455+ emails, automatic bounce handling.',
    stack: ['n8n', 'PocketBase', 'Ollama', 'Maileroo'],
  },
  {
    period: '2025',
    title: 'Full-Stack Platform Builder',
    role: 'rexbunnyservices.online',
    desc: 'Built the full agency platform — Astro website, PocketBase backend, n8n automation, and hardened production security (Cloudflare headers, CSP).',
    stack: ['Astro', 'PocketBase', 'n8n', 'Cloudflare'],
  },
  {
    period: '2026',
    title: 'Creative AI Pipelines',
    role: 'ComfyUI · Generative Systems',
    desc: 'Built generative AI asset pipelines and an LTX-2 video generation API — from model loading to automated launcher infrastructure.',
    stack: ['ComfyUI', 'LTX-2', 'Python', 'FastAPI'],
  },
  {
    period: '2025',
    title: 'Email & Deliverability',
    role: 'Listmonk · Titan · Maileroo',
    desc: 'Email marketing and nurture automation with validation, bounce detection, and multi-channel delivery fallback.',
    stack: ['Listmonk', 'Titan', 'Maileroo', 'IMAP'],
  },
];
---

<section class="section" id="timeline">
  <div class="container">
    <div class="section__head" data-num="03" data-reveal>
      <span class="section__kicker" data-kicker-num="/ 03">Work</span>
      <h2 class="section__title">Experience & <em>milestones</em>.</h2>
      <p class="section__lead">
        A journey of self-driven engineering across AI, automation, and full-stack
        web systems.
      </p>
    </div>

    <div class="work__list">
      {
        timeline.map((t, i) => (
          <article class="work__row" data-reveal data-delay={i * 60}>
            <span class="work__period">{t.period}</span>
            <div class="work__info">
              <h3>{t.title}</h3>
              <div class="role">{t.role}</div>
              <p>{t.desc}</p>
            </div>
            <div class="work__stack">
              {t.stack.map((s) => <span class="skill-chip">{s}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
