---
const stats = [
  { value: '100', label: 'Niches Searched', sub: '10 categories × 10 cities' },
  { value: '6', label: 'Audit Factors', sub: 'SEO + web-dev scoring tracks' },
  { value: '12', label: 'Web-Dev Score Scale', sub: 'AI-audited per prospect (0–12)' },
  { value: '0', label: 'Manual Steps', sub: 'Fully autonomous pipeline' },
];

const skills = [
  { icon: 'ri-reactjs-line', label: 'Astro' },
  { icon: 'ri-database-2-line', label: 'PocketBase' },
  { icon: 'ri-flow-chart', label: 'n8n' },
  { icon: 'ri-robot-2-line', label: 'Ollama / Gemini' },
  { icon: 'ri-mail-send-line', label: 'Maileroo' },
  { icon: 'ri-mail-open-line', label: 'Listmonk' },
  { icon: 'ri-bubble-chart-line', label: 'ComfyUI / LTX-2' },
  { icon: 'ri-cloud-line', label: 'Cloudflare' },
  { icon: 'ri-docker-line', label: 'Docker' },
  { icon: 'ri-search-line', label: 'SEO / AEO / GEO' },
];
---

<section class="section" id="about">
  <div class="container about__grid">
    <div class="about__stats" data-reveal>
      {stats.map((s) => (
        <div class="about__stat">
          <div class="num" data-count={s.value}>{s.value}</div>
          <div class="label">{s.label}</div>
          <div class="sub">{s.sub}</div>
        </div>
      ))}
    </div>

    <div class="about__text" data-reveal data-delay="120">
      <div class="section__head" data-num="01" style="margin-bottom:1.2rem;">
        <span class="section__kicker" data-kicker-num="/ 01">About</span>
        <h2 class="section__title">Automation is my <em>passion</em>.</h2>
      </div>

      <p>
        I'm a <b>Web · AI · Automation Developer</b> who builds intelligent
        platforms and self-running systems — modern websites, AI agents, and
        automation pipelines that turn complex operations into{' '}
        <b>measurable results</b> while you sleep.
      </p>
      <p>
        From a hardened Astro + PocketBase platform to a lead-gen engine that
        discovered and enriched <b>3,500+ prospects</b> on autopilot, I design
        ecosystems where every moving part is automated, monitored, and
        self-healing.
      </p>

      <div class="about__skills">
        {skills.map((s) => (
          <span class="skill-chip">
            <i class={s.icon}></i>
            {s.label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
