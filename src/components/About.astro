---
import Reveal from './Reveal.astro';
---

<section class="about section" id="about">
  <div class="about__container container grid">
    <div class="about__data">
      <Reveal>
        <h2 class="section__title">
          <span>Automation</span>
          <br />
          Is My Passion
        </h2>
        <p class="about__description">
          I'm a <b>Web · AI · Automation Developer</b> who builds intelligent
          platforms and self-running systems — modern websites, AI agents, and
          automation pipelines that turn complex operations into
          <b> measurable results </b> while you sleep.
        </p>
      </Reveal>

      <Reveal delay={120}>
        <div class="about__actions">
          <a href="#projects" class="button">
            My Projects <i class="ri-arrow-right-up-long-line"></i>
          </a>
          <a
            href="https://wa.me/919690380675"
            target="_blank"
            rel="noopener"
            class="button"
          >
            Let's Talk <i class="ri-whatsapp-line"></i>
          </a>
        </div>
      </Reveal>
    </div>
  </div>
</section>
