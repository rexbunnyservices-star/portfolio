---
import Reveal from './Reveal.astro';
---

<section id="contact">
  <div class="container">
    <Reveal>
      <span class="section-label">Let's work together</span>
      <h2 class="section-title">Ready to put your business on autopilot?</h2>
      <p class="section-sub" style="margin: 0 auto;">
        Whether you need a website, an AI agent, or a full automation pipeline — I'll build the
        system that grows your business while you sleep.
      </p>
    </Reveal>

    <Reveal delay={120}>
      <div class="contact-actions">
        <a class="btn btn-primary" href="mailto:hello@rexbunnyservices.online">Email me</a>
        <a class="btn btn-ghost" href="https://github.com/rexbunnyservices-star" target="_blank" rel="noopener">GitHub</a>
      </div>
    </Reveal>

    <Reveal delay={200}>
      <div class="contact-links">
        <span>📧 hello@rexbunnyservices.online</span>
        <a href="https://rexbunnyservices.online" target="_blank" rel="noopener">🌐 rexbunnyservices.online</a>
      </div>
    </Reveal>
  </div>
</section>
