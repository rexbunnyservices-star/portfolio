---
const businessEmail = 'help@rexbunnyservices.online';

const channels = [
  { icon: 'ri-mail-line', title: 'Email', value: businessEmail, href: `mailto:${businessEmail}` },
  { icon: 'ri-whatsapp-line', title: 'WhatsApp', value: '+91 96903 80675', href: 'https://wa.me/919690380675' },
  { icon: 'ri-github-line', title: 'GitHub', value: '@rexbunnyservices-star', href: 'https://github.com/rexbunnyservices-star' },
  { icon: 'ri-global-line', title: 'Website', value: 'rexbunnyservices.online', href: 'https://rexbunnyservices.online' },
];
---

<section class="section" id="contact">
  <div class="container">
    <div class="section__head" data-num="08" data-reveal>
      <span class="section__kicker" data-kicker-num="/ 08">Contact</span>
      <h2 class="section__title">Let's build your <em>ecosystem</em>.</h2>
      <p class="section__lead">
        Tell me about your project — whether it's an AI agent, a full platform,
        or a lead pipeline that runs itself.
      </p>
    </div>

    <div class="contact__grid">
      <div class="contact__channels" data-reveal>
        {
          channels.map((c) => (
            <a class="contact__channel" href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              <span class="ic"><i class={c.icon}></i></span>
              <div>
                <h4>{c.title}</h4>
                <p>{c.value}</p>
              </div>
            </a>
          ))
        }
        <div class="contact__aside">
          <i class="ri-time-line"></i>
          Typically replies within 24 hours · Worldwide, remote
        </div>
      </div>

      <form class="glass contact__card" id="contact-form" data-reveal data-delay="120">
        <h3>Send a message</h3>
        <p>Fill this in and it opens your email client pre-filled.</p>

        <div class="contact__field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" placeholder="Your name" required />
        </div>

        <div class="contact__field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" placeholder="you@company.com" required />
        </div>

        <div class="contact__field">
          <label for="cf-msg">Message</label>
          <textarea id="cf-msg" name="message" placeholder="Tell me about your project..." required></textarea>
        </div>

        <button type="submit" class="btn btn--primary magnetic" style="width:100%;">
          Send Message <i class="ri-send-plane-fill"></i>
        </button>
        <div class="form-status" id="form-status" role="status"></div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('cf-name')?.value.trim();
    const email = document.getElementById('cf-email')?.value.trim();
    const message = document.getElementById('cf-msg')?.value.trim();

    if (!name || !email || !message) {
      if (status) {
        status.textContent = 'Please fill in all fields.';
        status.className = 'form-status is-error';
      }
      return;
    }

    const subject = encodeURIComponent(`Project inquiry from ${name}`);
    const body = encodeURIComponent(`Hi Anas,\n\n${message}\n\n— ${name}\n${email}`);
    window.location.href = `mailto:${'help@rexbunnyservices.online'}?subject=${subject}&body=${body}`;

    if (status) {
      status.textContent = 'Opening your email client — or email help@rexbunnyservices.online directly';
      status.className = 'form-status';
    }
  });
</script>
