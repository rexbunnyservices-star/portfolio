---
import Reveal from './Reveal.astro';

const businessEmail = 'help@rexbunnyservices.online';
const personalEmail = 'rexbunnyservices@gmail.com';
---

<section class="contact section" id="contact">
  <div class="contact__container container grid">
    <div class="contact__data">
      <Reveal>
        <h2 class="section__title">Contact Me</h2>
        <p class="contact__description">Tell me about your next project.</p>

        <button class="contact__button button" id="contact-btn">
          Copy Email <i class="ri-file-copy-line"></i>
          <span class="contact__email" id="contact-email">{businessEmail}</span>
        </button>
      </Reveal>
    </div>

    <Reveal delay={120}>
      <div class="contact__content grid">
        <div class="contact__info grid">
          <div>
            <h3 class="contact__title">Business Email</h3>
            <address class="contact__address">{businessEmail}</address>
          </div>

          <div>
            <h3 class="contact__title">Personal Email</h3>
            <address class="contact__address">{personalEmail}</address>
          </div>

          <div>
            <h3 class="contact__title">Location</h3>
            <address class="contact__address">Available Worldwide · Remote</address>
          </div>
        </div>

        <div class="contact__social">
          <h3 class="contact__title">Find Me</h3>
          <div class="contact__links">
            <a
              href="https://github.com/rexbunnyservices-star"
              target="_blank"
              rel="noopener"
              class="contact__link"
            >
              GitHub <i class="ri-arrow-right-up-long-line"></i>
            </a>
            <a
              href="https://rexbunnyservices.online"
              target="_blank"
              rel="noopener"
              class="contact__link"
            >
              Website <i class="ri-arrow-right-up-long-line"></i>
            </a>
            <a
              href={`mailto:${personalEmail}`}
              class="contact__link"
            >
              Gmail <i class="ri-arrow-right-up-long-line"></i>
            </a>
          </div>
        </div>

        <div class="contact__write">
          <h3 class="contact__title">Write Me & We'll Talk</h3>
          <div class="contact__links">
            <a
              href="https://wa.me/919690380675"
              target="_blank"
              rel="noopener"
              class="contact__link"
            >
              WhatsApp <i class="ri-arrow-right-up-long-line"></i>
            </a>
            <a
              href={`mailto:${businessEmail}`}
              class="contact__link"
            >
              Business Email <i class="ri-arrow-right-up-long-line"></i>
            </a>
            <a
              href={`mailto:${personalEmail}`}
              class="contact__link"
            >
              Personal Email <i class="ri-arrow-right-up-long-line"></i>
            </a>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<script>
  const btn = document.getElementById('contact-btn');
  btn?.addEventListener('click', async () => {
    const email = document.getElementById('contact-email')?.textContent?.trim();
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = email;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    const icon = btn.querySelector('i');
    if (icon) icon.className = 'ri-check-line';
    btn.classList.add('contact-btn-copied');
    setTimeout(() => {
      if (icon) icon.className = 'ri-file-copy-line';
      btn.classList.remove('contact-btn-copied');
    }, 2000);
  });
</script>
