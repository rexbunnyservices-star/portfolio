---
import Reveal from './Reveal.astro';

const tech = [
  { cat: 'Frontend', skills: ['Astro', 'HTML', 'CSS', 'JavaScript', 'Responsive design', 'Accessibility'] },
  { cat: 'Backend & Data', skills: ['PocketBase', 'SQLite', 'REST APIs'] },
  { cat: 'Automation', skills: ['n8n', 'Docker', 'Cloudflared', 'Webhooks'] },
  { cat: 'AI / LLMs', skills: ['Google Gemini', 'Ollama', 'OpenCode agents', 'MCP'] },
  { cat: 'Creative AI', skills: ['ComfyUI', 'LTX-2', 'Generative pipelines'] },
  { cat: 'Email', skills: ['Listmonk', 'Maileroo', 'Titan SMTP / IMAP', 'Bounce handling'] },
];
---

<section class="tech section" id="stack">
  <Reveal>
    <h2 class="section__title">
      My Tech <br />
      <span>Arsenal</span>
    </h2>
  </Reveal>

  <div class="tech__grid container grid">
    {
      tech.map((t, i) => (
        <Reveal className="tech__cat" delay={(i % 3) * 60}>
          <h3>{t.cat}</h3>
          <div class="tech__skills">
            {t.skills.map((skill) => <span class="tech__skill">{skill}</span>)}
          </div>
        </Reveal>
      ))
    }
  </div>
</section>
