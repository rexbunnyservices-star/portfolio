---
import Terminal from './Terminal.astro';
import ThreeScene from './ThreeScene.astro';

const heroScript = [
  {
    cmd: 'whoami',
    out: [{ t: 'Mo. Anas Saifi — Web · AI · Automation Developer', c: 'ok' }],
  },
  {
    cmd: 'ls ./systems',
    out: [
      { t: 'agents/       lead-gen/     web/          seo/', c: 'hl' },
    ],
  },
  {
    cmd: './run-pipeline --full',
    out: [
      { t: '▶ discovering leads... 10 categories × 10 cities', c: 'out' },
      { t: '✓ 3,500+ leads found & AI-scored', c: 'ok' },
      { t: '✓ 455+ emails delivered · 77 bounces auto-cleaned', c: 'ok' },
      { t: '✓ 4 systems online · 24/7 · 0 manual steps', c: 'ok' },
    ],
  },
];

const actions = [
  {
    label: 'run status',
    script: [
      { cmd: './status', out: [{ t: '● lead pipeline   [online] 24/7', c: 'ok' }, { t: '● ai agents       [online]', c: 'ok' }, { t: '● email outreach  [online]', c: 'ok' }] },
    ],
  },
  {
    label: 'view stack',
    script: [
      { cmd: 'cat ./stack', out: [{ t: 'astrotech · pocketbase · n8n · ollama · maileroo · listmonk', c: 'hl' }] },
    ],
  },
];
---

<section class="hero" id="top">
  <div class="hero__beam" aria-hidden="true"></div>
  <ThreeScene className="hero__scene" />

  <div class="container hero__grid">
    <div class="hero__content hero__content--photo" data-reveal data-delay="150">
      <div class="hero__photo-card" data-reveal data-delay="300">
        <span class="stat-chip stat-chip--top">
          <i class="ri-line-chart-line"></i> 3,500+ leads
        </span>
        <div class="hero__photo-frame">
          <div class="hero__glow" aria-hidden="true"></div>
          <img
            src="/hero-photo.png"
            alt="Mo. Anas Saifi"
            width="560"
            height="746"
            loading="eager"
          />
        </div>
        <span class="stat-chip stat-chip--bottom">
          <i class="ri-mail-send-line"></i> 455+ sent
        </span>
      </div>
    </div>

    <div class="hero__content hero__content--text" data-reveal>
      <span class="hero__badge">
        <span class="pulse-dot" aria-hidden="true"></span>
        Available for new projects
      </span>

      <p class="hero__greeting">Hello, I'm</p>
      <h1 class="hero__name">
        Mo. Anas<br /><span class="serif">Saifi.</span>
      </h1>

      <p class="hero__quote">
        Architecting <b>complete digital ecosystems</b> — AI automations, web
        architecture, lead generation, and SEO/AEO/GEO under one roof.
      </p>

      <div class="hero__cta-row">
        <a href="#contact" class="btn btn--primary magnetic">
          Let's Talk <i class="ri-send-plane-fill"></i>
        </a>
        <a href="#work" class="btn btn--ghost">
          View Case Studies <i class="ri-arrow-right-up-line"></i>
        </a>
      </div>

      <div class="hero__meta">
        <span class="hero__meta-item">
          <i class="ri-flashlight-line"></i> 24/7 Automation
        </span>
        <span class="hero__meta-item">
          <i class="ri-global-line"></i> Remote · Worldwide
        </span>
        <span class="hero__meta-item">
          <i class="ri-verified-badge-line"></i> 4 Production Systems
        </span>
      </div>
    </div>


    <div class="hero__visual" data-reveal data-delay="150">
      <Terminal title="anas@dev — pipeline.sh" script={heroScript} actions={actions} />
    </div>
  </div>
</section>
