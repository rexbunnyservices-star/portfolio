---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Mo. Anas Saifi — AI Agents, Web Architecture & Automation', description = 'Portfolio of Mo. Anas Saifi — architecting complete digital ecosystems: custom AI agents, web architecture, automated lead gen, and SEO/AEO/GEO under one roof.' } = Astro.props;

const navLinks = [
  { href: '#capabilities', label: 'Capabilities' },
  { href: '#work', label: 'Case Studies' },
  { href: '#about', label: 'Stack' },
  { href: '#ai', label: 'AI Demo' },
  { href: '#faq', label: 'FAQ' },
  { href: '#contact', label: 'Contact' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mo. Anas Saifi',
  alternateName: 'Anas.dev',
  url: 'https://portfolio.rexbunnyservices.online',
  sameAs: [
    'https://github.com/rexbunnyservices-star',
    'https://wa.me/919690380675',
    'https://rexbunnyservices.online',
  ],
  email: 'mailto:help@rexbunnyservices.online',
  jobTitle: 'Web · AI · Automation Developer',
  knowsAbout: ['Web Development', 'AI Agents', 'Automation', 'SEO', 'AEO', 'GEO', 'Lead Generation', 'n8n', 'Astro', 'PocketBase'],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Anas.dev — Portfolio',
  url: 'https://portfolio.rexbunnyservices.online',
  author: { '@type': 'Person', name: 'Mo. Anas Saifi' },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Anas.dev — Digital Ecosystem Architecture',
  url: 'https://portfolio.rexbunnyservices.online',
  description: 'Architecting complete digital ecosystems: AI automations, web architecture, lead generation, and SEO/AEO/GEO under one roof.',
  areaServed: 'Worldwide',
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom AI Agents & Business Automation' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Modern Web Development & Architecture' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Automated Lead Generation & Outreach' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SEO / AEO / GEO Optimization' } },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What services do you offer?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Custom AI agents and business automation, modern web development with Astro and PocketBase, automated lead generation and outreach pipelines, and SEO/AEO/GEO optimization.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can you automate my entire lead generation process?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. I build end-to-end pipelines that discover, enrich, score, and reach out to prospects automatically — 3,500+ leads found and 455+ emails delivered with automatic bounce protection.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do you make businesses visible to AI engines?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'I apply AEO and GEO strategies — structured schema markup, semantic HTML, and extractable, answer-ready content — so businesses rank in both search engines and AI assistants like ChatGPT and Google AI Overviews.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you build AI agents that run 24/7?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. I build AI-agent systems that take on real company roles — CEO strategy, sales outreach, SEO audits, content, and support — operating around the clock on autopilot.',
      },
    },
  ],
};

const schemas = [personSchema, webSiteSchema, serviceSchema, faqSchema];
---

<!doctype html>

<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Mo. Anas Saifi" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fdf7f0" />
    <link rel="canonical" href="https://portfolio.rexbunnyservices.online" />

    <!-- Theme bootstrapper (runs before paint — no flash of wrong theme) -->
    <script is:inline>
      (function () {
        try {
          var dark = localStorage.getItem('theme')
            ? localStorage.getItem('theme') === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#0b0f22' : '#fdf7f0');
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://portfolio.rexbunnyservices.online" />
    <meta property="og:image" content="https://portfolio.rexbunnyservices.online/og-image.png" />
    <meta property="og:site_name" content="Anas.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://portfolio.rexbunnyservices.online/og-image.png" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/hero-photo.webp" fetchpriority="high" />

    <!-- Fonts: Satoshi (Fontshare) + Syne, Cormorant & JetBrains Mono (Google) -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Cormorant+Garamond:ital,wght@1,500;1,600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.min.css"
    />

    <!-- Structured data -->
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <title>{title}</title>
  </head>
  <body>
    <!-- FILM GRAIN -->
    <div class="grain" aria-hidden="true"></div>

    <!-- PROGRESS BAR -->
    <div class="progress" id="progress" aria-hidden="true"></div>

    <!-- HEADER -->
    <header class="header" id="header">
      <nav class="nav container">
        <a href="#top" class="nav__logo">
          <span class="nav__dot" aria-hidden="true"></span>
          Anas<span class="accent">.dev</span>
        </a>

        <div class="nav__menu" id="nav-menu">
          <ul class="nav__list">
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="nav__link">{link.label}</a>
                </li>
              ))
            }
          </ul>
          <a href="#contact" class="nav__cta">
            Let's Talk <i class="ri-arrow-right-up-line"></i>
          </a>
        </div>

        <button class="nav__theme" id="theme-toggle" role="switch" aria-label="Switch to dark mode" aria-pressed="false">
          <span class="nav__theme-track">
            <i class="ri-sun-line nav__theme-sun" aria-hidden="true"></i>
            <i class="ri-moon-line nav__theme-moon" aria-hidden="true"></i>
            <span class="nav__theme-fallback nav__theme-fallback--sun" aria-hidden="true">☀</span>
            <span class="nav__theme-fallback nav__theme-fallback--moon" aria-hidden="true">☾</span>
            <span class="nav__theme-thumb" aria-hidden="true"></span>
          </span>
        </button>

        <button class="nav__burger" id="nav-burger" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </nav>
    </header>

    <!-- CUSTOM CURSOR -->
    <div class="cursor" id="cursor" aria-hidden="true"></div>

    <main class="main" id="top">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="container footer__grid">
        <div class="footer__brand">
          <span class="nav__logo">
            <span class="nav__dot" aria-hidden="true"></span>
            Anas<span class="accent">.dev</span>
          </span>
          <p>Architecting complete digital ecosystems — AI, web, lead gen, and SEO under one roof.</p>
        </div>
        <div class="footer__col">
          <h4>Menu</h4>
          <a href="#capabilities">Capabilities</a>
          <a href="#work">Case Studies</a>
          <a href="#ai">AI Demo</a>
          <a href="#faq">FAQ</a>
        </div>
        <div class="footer__col">
          <h4>Connect</h4>
          <a href="https://github.com/rexbunnyservices-star" target="_blank" rel="noopener">GitHub</a>
          <a href="https://wa.me/919690380675" target="_blank" rel="noopener">WhatsApp</a>
          <a href="mailto:help@rexbunnyservices.online">Email</a>
        </div>
      </div>
      <div class="footer__bar">
        <p>© <span id="footer-year">{new Date().getFullYear()}</span> Mo. Anas Saifi — All rights reserved</p>
        <p>Built with Astro · Deployed on Cloudflare Pages</p>
      </div>
    </footer>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';

      document.documentElement.classList.replace('no-js', 'js');

      // Theme toggle — warm light ⇄ midnight dark (symbols never break)
      const setTheme = (dark, persist) => {
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', dark ? '#0b0f22' : '#fdf7f0');
        const btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.setAttribute('aria-pressed', String(dark));
          btn.setAttribute('aria-label', dark ? 'Switch to warm mode' : 'Switch to dark mode');
        }
        if (persist) {
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch (e) {}
        }
      };
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        setTheme(document.documentElement.dataset.theme !== 'dark', true);
      });
      setTheme(document.documentElement.dataset.theme === 'dark', false);

      // Remixicon fallback guard — show the inline ☀ / ☾ symbols if the icon font is ever unavailable
      if (document.fonts && document.fonts.load) {
        document.fonts
          .load('16px remixicon')
          .then((faces) => {
            if (!faces || faces.length === 0) document.documentElement.classList.add('no-remixicon');
          })
          .catch(() => document.documentElement.classList.add('no-remixicon'));
      }

      // Smooth scroll (Lenis) + scroll progress bar
      const lenis = new Lenis({
        duration: 1.15,
        smoothWheel: true,
      });
      lenis.on('scroll', () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        const p = max > 0 ? (window.scrollY / max) * 100 : 0;
        const bar = document.getElementById('progress');
        if (bar) bar.style.transform = `scaleX(${p / 100})`;
      });
      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
      window.lenis = lenis;

      // Anchor clicks → smooth scroll via Lenis
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href');
          if (id.length < 2) return;
          const el = document.querySelector(id);
          if (!el) return;
          e.preventDefault();
          lenis.scrollTo(el, { offset: -80, duration: 1.4 });
        });
      });

      // Custom cursor (desktop only)
      const cursor = document.getElementById('cursor');
      const fine = window.matchMedia('(pointer: fine)').matches;
      if (fine && cursor) {
        let tx = 0, ty = 0, cx = 0, cy = 0;
        document.addEventListener('mousemove', (e) => {
          tx = e.clientX;
          ty = e.clientY;
          cursor.classList.add('cursor--on');
        });
        const growTargets = 'a, button, .magnetic, [data-cursor]';
        document.addEventListener('mouseover', (e) => {
          if (e.target.closest(growTargets)) cursor.classList.add('cursor--grow');
        });
        document.addEventListener('mouseout', (e) => {
          if (e.target.closest(growTargets)) cursor.classList.remove('cursor--grow');
        });
        (function loop() {
          cx += (tx - cx) * 0.16;
          cy += (ty - cy) * 0.16;
          cursor.style.transform = `translate(${cx - 12}px, ${cy - 12}px)`;
          requestAnimationFrame(loop);
        })();
      }

      // Active nav link on scroll
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.nav__link');
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              navLinks.forEach((l) =>
                l.classList.toggle('active-link', l.getAttribute('href') === `#${entry.target.id}`)
              );
            }
          }
        },
        { rootMargin: '-40% 0px -55% 0px' }
      );
      sections.forEach((s) => spy.observe(s));

      // Header shadow on scroll
      const header = document.getElementById('header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Mobile menu toggle
      const burger = document.getElementById('nav-burger');
      const menu = document.querySelector('.nav__menu');
      if (burger && menu) {
        const setOpen = (open) => {
          menu.classList.toggle('is-open', open);
          burger.classList.toggle('is-active', open);
          burger.setAttribute('aria-expanded', String(open));
        };
        const closeMenu = (returnFocus) => {
          setOpen(false);
          if (returnFocus) burger.focus();
        };
        burger.addEventListener('click', () => {
          const open = !menu.classList.contains('is-open');
          setOpen(open);
          if (open) menu.querySelector('a, button')?.focus();
        });
        menu.addEventListener('click', (e) => {
          if (e.target.closest('a')) closeMenu(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.classList.contains('is-open')) {
            closeMenu(true);
            return;
          }
          if (e.key === 'Tab' && menu.classList.contains('is-open')) {
            const focusables = [...menu.querySelectorAll('a, button')].filter(
              (el) => el.offsetParent !== null
            );
            if (focusables.length === 0) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 960) closeMenu(false);
        });
      }

      // GSAP reveal animations
      gsap.registerPlugin(ScrollTrigger);
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        const items = gsap.utils.toArray('[data-reveal]');
        items.forEach((el) => {
          const delay = Number(el.dataset.delay || 0) / 1000;
          gsap.fromTo(
            el,
            { y: 32, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.85,
              ease: 'power3.out',
              delay,
              scrollTrigger: { trigger: el, start: 'top 88%', once: true },
            }
          );
        });
      }

      // Hero scene fade-out on scroll
      const heroScene = document.querySelector('.hero__scene');
      const heroSection = document.querySelector('.hero');
      if (heroScene && heroSection && !reduced) {
        gsap.to(heroScene, {
          opacity: 0,
          ease: 'none',
          scrollTrigger: {
            trigger: heroSection,
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        });
      }

      // Bento spotlight — mouse-tracking radial glow
      if (fine && !reduced) {
        document.querySelectorAll('.bento__card').forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const r = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${e.clientX - r.left}px`);
            card.style.setProperty('--my', `${e.clientY - r.top}px`);
          });
        });
      }

      // Count-up for numeric stats (Results + About)
      if (!reduced) {
        const numEls = document.querySelectorAll('[data-count]');
        numEls.forEach((el) => {
          const target = el.dataset.count;
          const match = String(target).match(/^([^0-9]*)([\d,.]+)(.*)$/);
          if (!match) return;
          const prefix = match[1];
          const raw = match[2];
          const suffix = match[3];
          const targetNum = parseFloat(raw.replace(/,/g, ''));
          const obj = { v: 0 };
          gsap.to(obj, {
            v: targetNum,
            duration: 1.6,
            ease: 'power2.out',
            scrollTrigger: { trigger: el, start: 'top 88%', once: true },
            onUpdate() {
              const formatted = Number(obj.v.toFixed(0)).toLocaleString('en-US');
              el.textContent = `${prefix}${formatted}${suffix}`;
            },
          });
        });
      }

      // Magnetic buttons
      if (fine && !reduced) {
        document.querySelectorAll('.magnetic').forEach((btn) => {
          btn.addEventListener('mousemove', (e) => {
            const r = btn.getBoundingClientRect();
            const dx = (e.clientX - (r.left + r.width / 2)) * 0.22;
            const dy = (e.clientY - (r.top + r.height / 2)) * 0.22;
            btn.style.transform = `translate(${dx}px, ${dy}px)`;
          });
          btn.addEventListener('mouseleave', () => {
            btn.style.transform = '';
          });
        });
      }

      // Hero photo card tilt
      const photoCard = document.querySelector('.hero__photo-card');
      if (photoCard && fine && !reduced) {
        photoCard.addEventListener('mousemove', (e) => {
          const r = photoCard.getBoundingClientRect();
          const rx = ((e.clientY - r.top) / r.height - 0.5) * -6;
          const ry = ((e.clientX - r.left) / r.width - 0.5) * 6;
          photoCard.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-4px)`;
        });
        photoCard.addEventListener('mouseleave', () => {
          photoCard.style.transform = '';
        });
      }
    </script>
  </body>
</html>
